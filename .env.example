# ==============================================================================
# Euroshub Logistics Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env with real credentials to source control.

# Database & Prisma (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/euroshub_db?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/euroshub_db?schema=public"

# Supabase Server-Side Credentials (NEVER expose to frontend)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-placeholder"

# API Server Settings
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Frontend Vite Client Settings (only variables prefixed with VITE_ are accessible to the browser)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"
VITE_API_BASE_URL="http://localhost:4000"

# Development Staff Account Provisioning (run: npm run seed:staff)
# NEVER commit DEV_STAFF_PASSWORD to source control.
ALLOW_DEV_STAFF_SEED=false
DEV_STAFF_PASSWORD="your-secure-dev-password-placeholder"
DEV_ADMIN_EMAIL="admin@euroshub.com"
DEV_HUB_STAFF_EMAIL="hubstaff@euroshub.com"
DEV_DRIVER_EMAIL="driver@euroshub.com"
